---
interface Props {
  title: string;
  description: string;
  keywords: string;
  serviceName: string;
  serviceCategory: "Recruitment Marketing" | "Employer Branding";
}

const { title, description, keywords, serviceName, serviceCategory } = Astro.props;

import BaseLayout from './BaseLayout.astro';
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <slot name="head" slot="head" />
  
  <div class="service-page">
    <header class="service-hero">
      <div class="container">
        <p class="service-category">{serviceCategory}</p>
        <h1>{serviceName}</h1>
        <p class="service-intro"><slot name="intro" /></p>
        <a href="/contact" class="btn btn-primary">Discuss Your Needs</a>
      </div>
    </header>

    <slot />

    <section class="service-cta">
      <div class="container">
        <h2>Ready to get started?</h2>
        <p>Let's discuss how this service can help your organisation achieve its talent goals.</p>
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .service-page {
    padding-top: 80px;
  }

  .service-hero {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: white;
    padding: 4rem 0;
    text-align: center;
  }

  .service-category {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #64ffda;
    margin-bottom: 1rem;
  }

  .service-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1.5rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .service-intro {
    font-size: 1.125rem;
    max-width: 700px;
    margin: 0 auto 2rem;
    opacity: 0.9;
    line-height: 1.7;
  }

  .service-cta {
    background: #f8f9fa;
    padding: 4rem 0;
    text-align: center;
  }

  .service-cta h2 {
    margin-bottom: 1rem;
  }

  .service-cta p {
    margin-bottom: 2rem;
    color: #666;
  }
</style>
