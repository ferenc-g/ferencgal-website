---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const title = "Outsourced Recruitment Marketing | Fractional Support | Ferenc Gal";
const description = "Embedded recruitment marketing support on a fractional basis. Get dedicated expertise without full-time overhead. Campaign execution, content, and strategy.";
const keywords = "outsourced recruitment marketing, fractional recruitment marketing, recruitment marketing support, talent marketing, embedded marketing, recruitment marketing consultant";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is outsourced recruitment marketing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Outsourced recruitment marketing provides dedicated recruitment marketing expertise on a fractional or part-time basis. Rather than hiring a full-time specialist, you gain access to experienced support for a set number of days per week or month, covering strategy, campaign execution, content creation, and performance optimisation."
      }
    },
    {
      "@type": "Question",
      "name": "How many days per week do you typically work with clients?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Engagements typically range from 1-3 days per week depending on hiring volume and recruitment marketing maturity. Some clients need intensive support during hiring surges, while others require steady-state ongoing support. We design engagement models around your specific needs."
      }
    },
    {
      "@type": "Question",
      "name": "What activities are included in outsourced recruitment marketing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Activities typically include campaign strategy and planning, job advertising and media buying, social media content creation and management, careers site content updates, employer brand asset development, Glassdoor and Indeed management, performance reporting and optimisation, and stakeholder communication."
      }
    },
    {
      "@type": "Question",
      "name": "How do you integrate with our existing team?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We embed within your organisation, attending relevant meetings, using your systems and processes, and collaborating directly with HR, talent acquisition, and hiring managers. The goal is seamless integration so we function as an extension of your team rather than an external vendor."
      }
    },
    {
      "@type": "Question",
      "name": "What is the minimum engagement period?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We typically recommend a minimum 3-month initial engagement to allow time for onboarding, strategy development, and meaningful campaign execution. After this period, engagements can continue on a rolling monthly basis with flexibility to adjust scope as needs change."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Outsourced Recruitment Marketing",
  "description": "Fractional recruitment marketing support embedded within your organisation.",
  "provider": {
    "@type": "Person",
    "name": "Ferenc Gal",
    "url": "https://ferencgal.com"
  },
  "serviceType": "Recruitment Marketing Consulting",
  "areaServed": ["Ireland", "Europe"]
};
---

<ServiceLayout
  title={title}
  description={description}
  keywords={keywords}
  serviceName="Outsourced Recruitment Marketing"
  serviceCategory="Recruitment Marketing"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <Fragment slot="intro">
    Dedicated recruitment marketing expertise embedded within your organisation on a fractional basis. Get the strategic and hands-on support you need without full-time overhead.
  </Fragment>

  <section class="service-section">
    <div class="container">
      <h2>Why Outsource Recruitment Marketing?</h2>
      <p>Many organisations recognise they need dedicated recruitment marketing capability but cannot justify a full-time hire. Volume may not support it, budget constraints exist, or the skills required are difficult to find and retain.</p>
      <p>Outsourced recruitment marketing solves this challenge. You gain access to experienced expertise on a flexible basis, scaling up during hiring surges and scaling down during quieter periods. You get strategic guidance alongside hands-on execution, without the overhead of a permanent headcount.</p>
      <p>This model is particularly effective for organisations in growth phases, those launching new employer brands, or companies with seasonal hiring patterns that make permanent recruitment marketing roles impractical.</p>
    </div>
  </section>

  <section class="service-section service-section--alt">
    <div class="container">
      <h2>What Is Included</h2>
      <div class="included-grid">
        <div class="included-item">
          <h3>Strategy and Planning</h3>
          <ul>
            <li>Recruitment marketing strategy development</li>
            <li>Campaign planning and calendar management</li>
            <li>Channel strategy and media planning</li>
            <li>Budget allocation and optimisation</li>
            <li>KPI definition and tracking setup</li>
          </ul>
        </div>
        <div class="included-item">
          <h3>Campaign Execution</h3>
          <ul>
            <li>Job advertising and programmatic media</li>
            <li>Social media campaign management</li>
            <li>Paid search and display advertising</li>
            <li>Email marketing for talent pools</li>
            <li>Event promotion and coordination</li>
          </ul>
        </div>
        <div class="included-item">
          <h3>Content Creation</h3>
          <ul>
            <li>Employee stories and testimonials</li>
            <li>Job description optimisation</li>
            <li>Careers site content updates</li>
            <li>Social media content calendar</li>
            <li>Blog and thought leadership content</li>
          </ul>
        </div>
        <div class="included-item">
          <h3>Brand Management</h3>
          <ul>
            <li>Glassdoor response and optimisation</li>
            <li>Indeed company page management</li>
            <li>LinkedIn company page content</li>
            <li>Employer brand consistency review</li>
            <li>Review monitoring and response</li>
          </ul>
        </div>
        <div class="included-item">
          <h3>Analytics and Reporting</h3>
          <ul>
            <li>Campaign performance tracking</li>
            <li>Source of hire analysis</li>
            <li>Cost-per-hire reporting</li>
            <li>Monthly performance dashboards</li>
            <li>Optimisation recommendations</li>
          </ul>
        </div>
        <div class="included-item">
          <h3>Stakeholder Support</h3>
          <ul>
            <li>Hiring manager consultation</li>
            <li>Talent acquisition team support</li>
            <li>Agency and vendor coordination</li>
            <li>Leadership reporting and updates</li>
            <li>Cross-functional collaboration</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="service-section">
    <div class="container">
      <h2>Engagement Models</h2>
      <div class="models-grid">
        <div class="model-card">
          <h3>Steady State</h3>
          <p class="model-days">1-2 days per week</p>
          <p>Ongoing recruitment marketing support for organisations with consistent hiring needs. Ideal for maintaining employer brand presence, managing always-on campaigns, and providing strategic guidance.</p>
          <ul>
            <li>Regular campaign management</li>
            <li>Content calendar execution</li>
            <li>Monthly reporting</li>
            <li>Stakeholder communication</li>
          </ul>
        </div>
        <div class="model-card model-card--featured">
          <h3>Growth Mode</h3>
          <p class="model-days">2-3 days per week</p>
          <p>Intensive support for organisations in growth phases or launching major hiring initiatives. Provides the bandwidth for strategic projects alongside day-to-day execution.</p>
          <ul>
            <li>All steady state activities</li>
            <li>Large-scale campaign launches</li>
            <li>Employer brand projects</li>
            <li>Process improvement initiatives</li>
          </ul>
        </div>
        <div class="model-card">
          <h3>Project Based</h3>
          <p class="model-days">Flexible duration</p>
          <p>Defined scope engagements for specific initiatives such as careers site launches, employer brand campaigns, or hiring event support. Clear deliverables and timelines.</p>
          <ul>
            <li>Scoped deliverables</li>
            <li>Fixed timeline</li>
            <li>Project management</li>
            <li>Knowledge transfer</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="service-section service-section--alt">
    <div class="container">
      <h2>How We Work Together</h2>
      <div class="process-steps">
        <div class="process-step">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>Discovery and Scoping</h3>
            <p>We assess your current recruitment marketing maturity, hiring plans, and specific needs to design an engagement model that fits your organisation.</p>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>Onboarding</h3>
            <p>We integrate with your team, gain access to systems, understand processes, and build relationships with key stakeholders. Typically 2-3 weeks.</p>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>Strategy Development</h3>
            <p>We develop a recruitment marketing plan aligned with your hiring objectives, employer brand, and budget. This provides the roadmap for ongoing execution.</p>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">4</div>
          <div class="step-content">
            <h3>Ongoing Execution</h3>
            <p>We execute against the plan, managing campaigns, creating content, and optimising performance. Regular check-ins ensure alignment and allow for agile adjustments.</p>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">5</div>
          <div class="step-content">
            <h3>Reporting and Optimisation</h3>
            <p>Monthly reporting provides visibility into performance. We continuously optimise based on data, reallocating budget and adjusting tactics to improve results.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="service-section">
    <div class="container">
      <h2>Who This Service Suits</h2>
      <ul class="benefits-list">
        <li><strong>Growing organisations</strong> that need recruitment marketing capability but cannot justify a full-time hire</li>
        <li><strong>Companies with variable hiring</strong> that experience peaks and troughs throughout the year</li>
        <li><strong>Organisations building capability</strong> that want expert guidance while developing internal skills</li>
        <li><strong>Teams launching initiatives</strong> such as new employer brands, careers sites, or major hiring campaigns</li>
        <li><strong>HR and TA teams</strong> that lack marketing expertise and need specialist support</li>
        <li><strong>Budget-conscious organisations</strong> that want senior expertise at a fraction of full-time cost</li>
      </ul>
    </div>
  </section>

  <section class="service-section service-section--alt">
    <div class="container">
      <h2>Related Services</h2>
      <div class="related-services">
        <a href="/services/recruitment-marketing-audit" class="related-service">
          <h3>Recruitment Marketing Audit</h3>
          <p>Start with an assessment before ongoing support</p>
        </a>
        <a href="/services/recruitment-marketing-strategy" class="related-service">
          <h3>Recruitment Marketing Strategy</h3>
          <p>Develop a comprehensive strategy to guide execution</p>
        </a>
        <a href="/services/employer-brand-activation" class="related-service">
          <h3>Employer Brand Activation</h3>
          <p>Launch campaigns to bring your employer brand to life</p>
        </a>
      </div>
    </div>
  </section>

  <section class="service-section">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3>What is outsourced recruitment marketing?</h3>
          <p>Outsourced recruitment marketing provides dedicated expertise on a fractional or part-time basis. You gain access to experienced support for strategy, campaign execution, content creation, and performance optimisation without hiring full-time.</p>
        </div>
        <div class="faq-item">
          <h3>How many days per week do you typically work with clients?</h3>
          <p>Engagements typically range from 1-3 days per week depending on hiring volume and recruitment marketing maturity. We design engagement models around your specific needs.</p>
        </div>
        <div class="faq-item">
          <h3>What activities are included?</h3>
          <p>Activities typically include campaign strategy, job advertising, social media management, careers site content, Glassdoor and Indeed management, performance reporting, and stakeholder communication.</p>
        </div>
        <div class="faq-item">
          <h3>How do you integrate with our existing team?</h3>
          <p>We embed within your organisation, attending meetings, using your systems, and collaborating directly with HR, talent acquisition, and hiring managers as an extension of your team.</p>
        </div>
        <div class="faq-item">
          <h3>What is the minimum engagement period?</h3>
          <p>We recommend a minimum 3-month initial engagement for onboarding, strategy development, and meaningful campaign execution. After this, engagements continue on a rolling monthly basis.</p>
        </div>
      </div>
    </div>
  </section>
</ServiceLayout>

<style>
  .service-section {
    padding: 4rem 0;
  }

  .service-section--alt {
    background: #f8f9fa;
  }

  .service-section h2 {
    margin-bottom: 1.5rem;
    font-size: 1.75rem;
  }

  .service-section p {
    margin-bottom: 1rem;
    line-height: 1.7;
    color: #444;
  }

  .included-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .included-item {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .included-item h3 {
    font-size: 1.125rem;
    margin-bottom: 1rem;
    color: #1a1a2e;
  }

  .included-item ul {
    list-style: none;
    padding: 0;
  }

  .included-item li {
    padding: 0.4rem 0;
    padding-left: 1.25rem;
    position: relative;
    color: #555;
    font-size: 0.875rem;
  }

  .included-item li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #64ffda;
  }

  .models-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .model-card {
    background: #f8f9fa;
    padding: 2rem;
    border-radius: 8px;
    border: 2px solid transparent;
  }

  .model-card--featured {
    background: white;
    border-color: #64ffda;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  }

  .model-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: #1a1a2e;
  }

  .model-days {
    font-size: 0.875rem;
    color: #64ffda;
    font-weight: 600;
    margin-bottom: 1rem !important;
  }

  .model-card ul {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
  }

  .model-card li {
    padding: 0.4rem 0;
    padding-left: 1.25rem;
    position: relative;
    color: #555;
    font-size: 0.875rem;
  }

  .model-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #64ffda;
  }

  .process-steps {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }

  .process-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .step-number {
    width: 48px;
    height: 48px;
    background: #1a1a2e;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .step-content h3 {
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
  }

  .step-content p {
    margin: 0;
    color: #555;
  }

  .benefits-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .benefits-list li {
    padding: 1rem;
    background: #f8f9fa;
    border-radius: 8px;
    border-left: 4px solid #64ffda;
  }

  .related-services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .related-service {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .related-service:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
  }

  .related-service h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    color: #1a1a2e;
  }

  .related-service p {
    margin: 0;
    font-size: 0.875rem;
    color: #666;
  }

  .faq-list {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .faq-item {
    background: #f8f9fa;
    padding: 1.5rem;
    border-radius: 8px;
  }

  .faq-item h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: #1a1a2e;
  }

  .faq-item p {
    margin: 0;
    font-size: 0.9375rem;
  }

  @media (max-width: 768px) {
    .process-step {
      grid-template-columns: 1fr;
    }

    .step-number {
      width: 40px;
      height: 40px;
      font-size: 1rem;
    }
  }
</style>
