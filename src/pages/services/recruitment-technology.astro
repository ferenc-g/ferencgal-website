---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const title = "Recruitment Marketing Technology Consulting | Ferenc Gal";
const description = "Expert guidance on selecting, implementing, and optimising recruitment marketing technology. Vendor evaluation, RFP development, and implementation support.";
const keywords = "recruitment technology consulting, recruitment marketing technology, HR tech selection, recruitment CRM, recruitment marketing automation, HR technology implementation";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is recruitment marketing technology?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Recruitment marketing technology includes tools that help organisations attract and engage talent, such as recruitment CRMs, talent communities, recruitment marketing platforms, programmatic advertising tools, career site platforms, chatbots, and analytics solutions."
      }
    },
    {
      "@type": "Question",
      "name": "How do you select the right recruitment technology?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Selection should begin with understanding your specific challenges and requirements, not with vendor demos. We help organisations define requirements, evaluate options against those requirements, conduct vendor assessments, and select solutions that fit your technology ecosystem and organisational maturity."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a recruitment technology implementation take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Implementation timelines vary significantly by solution complexity. Simple tools may take 4-6 weeks; enterprise platforms can take 6-12 months. Key factors include integration requirements, data migration complexity, customisation needs, and organisational change management."
      }
    },
    {
      "@type": "Question",
      "name": "What causes recruitment technology implementations to fail?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Common failure causes include: selecting technology before defining requirements, underestimating integration complexity, insufficient change management, lack of executive sponsorship, inadequate training, and not aligning technology with process changes."
      }
    },
    {
      "@type": "Question",
      "name": "Do you recommend specific vendors?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We provide independent, vendor-agnostic advice based on your specific requirements. We do not have commercial relationships with technology vendors, ensuring our recommendations are based solely on fit for your organisation."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Recruitment Marketing Technology Consulting",
  "description": "Expert guidance on selecting, implementing, and optimising recruitment marketing technology.",
  "provider": {
    "@type": "Person",
    "name": "Ferenc Gal",
    "url": "https://ferencgal.com"
  },
  "serviceType": "Recruitment Marketing Consulting",
  "areaServed": ["Ireland", "Europe"]
};
---

<ServiceLayout
  title={title}
  description={description}
  keywords={keywords}
  serviceName="Recruitment Technology"
  serviceCategory="Recruitment Marketing"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <Fragment slot="intro">
    Expert guidance on selecting, implementing, and optimising recruitment marketing technology to support your talent attraction efforts. Independent, vendor-agnostic advice focused on your needs.
  </Fragment>

  <section class="service-section">
    <div class="container">
      <h2>The Challenge with Recruitment Technology</h2>
      <p>The recruitment technology landscape is crowded and confusing. Hundreds of vendors compete with overlapping features and bold promises. Making the wrong choice can mean wasted investment, failed implementations, and frustrated teams.</p>
      <p>Many organisations buy technology before they understand their requirements. They get swayed by impressive demos rather than evaluating fit for their specific context. They underestimate integration complexity and change management requirements.</p>
      <p>Independent guidance helps you cut through vendor marketing, understand what you actually need, and select solutions that will deliver value in your specific environment.</p>
    </div>
  </section>

  <section class="service-section service-section--alt">
    <div class="container">
      <h2>Technology Categories We Cover</h2>
      <div class="tech-categories">
        <div class="tech-category">
          <h3>Recruitment CRM</h3>
          <p>Platforms for building and nurturing talent pipelines before roles open.</p>
          <ul>
            <li>Candidate relationship management</li>
            <li>Talent community platforms</li>
            <li>Nurture campaign automation</li>
            <li>Pipeline analytics</li>
          </ul>
        </div>
        <div class="tech-category">
          <h3>Recruitment Marketing Platforms</h3>
          <p>Integrated solutions for managing employer brand content and campaigns.</p>
          <ul>
            <li>Career site platforms</li>
            <li>Content management systems</li>
            <li>Social media management</li>
            <li>Recruitment marketing suites</li>
          </ul>
        </div>
        <div class="tech-category">
          <h3>Advertising Technology</h3>
          <p>Tools for optimising job advertising spend and candidate targeting.</p>
          <ul>
            <li>Programmatic job advertising</li>
            <li>Job distribution platforms</li>
            <li>Candidate targeting tools</li>
            <li>Attribution and analytics</li>
          </ul>
        </div>
        <div class="tech-category">
          <h3>Candidate Engagement</h3>
          <p>Solutions for improving candidate communication and experience.</p>
          <ul>
            <li>Chatbots and conversational AI</li>
            <li>Scheduling automation</li>
            <li>Video interviewing platforms</li>
            <li>Candidate feedback tools</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="service-section">
    <div class="container">
      <h2>How We Help</h2>
      <div class="process-steps">
        <div class="process-step">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>Requirements Definition</h3>
            <p>We work with stakeholders to understand your challenges, processes, and goals. We document functional requirements, integration needs, and success criteria before any vendor conversations.</p>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>Landscape Assessment</h3>
            <p>We identify vendors that could meet your requirements, filtering the market down to a manageable shortlist based on fit, not vendor marketing spend.</p>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>RFP Development</h3>
            <p>We create structured RFPs that enable fair comparison and surface the information you need to make informed decisions.</p>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">4</div>
          <div class="step-content">
            <h3>Vendor Evaluation</h3>
            <p>We facilitate demos, score responses, conduct reference checks, and help you evaluate total cost of ownership including implementation and ongoing costs.</p>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">5</div>
          <div class="step-content">
            <h3>Selection and Negotiation</h3>
            <p>We provide recommendations with clear rationale and support contract negotiation to ensure favourable terms and SLAs.</p>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">6</div>
          <div class="step-content">
            <h3>Implementation Support</h3>
            <p>We help plan implementations, define success metrics, and provide oversight to ensure projects deliver expected outcomes.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="service-section service-section--alt">
    <div class="container">
      <h2>What You Receive</h2>
      <div class="deliverables">
        <div class="deliverable">
          <h3>Requirements Document</h3>
          <p>Comprehensive requirements specification covering functional, technical, and integration needs.</p>
        </div>
        <div class="deliverable">
          <h3>Market Assessment</h3>
          <p>Analysis of relevant vendors with initial fit assessment against your requirements.</p>
        </div>
        <div class="deliverable">
          <h3>RFP Package</h3>
          <p>Complete RFP documentation ready for vendor distribution.</p>
        </div>
        <div class="deliverable">
          <h3>Evaluation Scorecard</h3>
          <p>Structured scoring framework with weighted criteria and vendor assessments.</p>
        </div>
        <div class="deliverable">
          <h3>Recommendation Report</h3>
          <p>Final recommendation with supporting rationale and risk considerations.</p>
        </div>
        <div class="deliverable">
          <h3>Implementation Plan</h3>
          <p>Roadmap for successful implementation including milestones and success criteria.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="service-section">
    <div class="container">
      <h2>Related Services</h2>
      <p>Technology consulting often connects with these services:</p>
      <div class="related-services">
        <a href="/services/recruitment-marketing-audit" class="related-service">
          <h3>Recruitment Marketing Audit</h3>
          <p>Identify technology gaps in your current setup</p>
        </a>
        <a href="/services/pilots-poc" class="related-service">
          <h3>Pilots & Proof of Concepts</h3>
          <p>Test technologies before full commitment</p>
        </a>
        <a href="/services/outsourced-recruitment-marketing" class="related-service">
          <h3>Outsourced Recruitment Marketing</h3>
          <p>Get help maximising your technology investment</p>
        </a>
      </div>
    </div>
  </section>

  <section class="service-section service-section--alt">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3>What is recruitment marketing technology?</h3>
          <p>Recruitment marketing technology includes tools that help organisations attract and engage talent, such as recruitment CRMs, talent communities, recruitment marketing platforms, programmatic advertising tools, career site platforms, chatbots, and analytics solutions.</p>
        </div>
        <div class="faq-item">
          <h3>How do you select the right recruitment technology?</h3>
          <p>Selection should begin with understanding your specific challenges and requirements, not with vendor demos. We help organisations define requirements, evaluate options against those requirements, conduct vendor assessments, and select solutions that fit your technology ecosystem and organisational maturity.</p>
        </div>
        <div class="faq-item">
          <h3>How long does a recruitment technology implementation take?</h3>
          <p>Implementation timelines vary significantly by solution complexity. Simple tools may take 4-6 weeks; enterprise platforms can take 6-12 months. Key factors include integration requirements, data migration complexity, customisation needs, and organisational change management.</p>
        </div>
        <div class="faq-item">
          <h3>What causes recruitment technology implementations to fail?</h3>
          <p>Common failure causes include: selecting technology before defining requirements, underestimating integration complexity, insufficient change management, lack of executive sponsorship, inadequate training, and not aligning technology with process changes.</p>
        </div>
        <div class="faq-item">
          <h3>Do you recommend specific vendors?</h3>
          <p>We provide independent, vendor-agnostic advice based on your specific requirements. We do not have commercial relationships with technology vendors, ensuring our recommendations are based solely on fit for your organisation.</p>
        </div>
      </div>
    </div>
  </section>
</ServiceLayout>

<style>
  .service-section {
    padding: 4rem 0;
  }

  .service-section--alt {
    background: #f8f9fa;
  }

  .service-section h2 {
    margin-bottom: 1.5rem;
    font-size: 1.75rem;
  }

  .service-section p {
    margin-bottom: 1rem;
    line-height: 1.7;
    color: #444;
  }

  .tech-categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .tech-category {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .tech-category h3 {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
    color: #1d3557;
  }

  .tech-category > p {
    font-size: 0.9375rem;
    margin-bottom: 1rem;
  }

  .tech-category ul {
    list-style: none;
    padding: 0;
  }

  .tech-category li {
    padding: 0.4rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: #555;
    font-size: 0.875rem;
  }

  .tech-category li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #2a9d8f;
    font-weight: bold;
  }

  .process-steps {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }

  .process-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .step-number {
    width: 48px;
    height: 48px;
    background: #1d3557;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .step-content h3 {
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
  }

  .step-content p {
    margin: 0;
    color: #555;
  }

  .deliverables {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .deliverable {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .deliverable h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: #1d3557;
  }

  .deliverable p {
    margin: 0;
    font-size: 0.9375rem;
    color: #555;
  }

  .related-services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .related-service {
    background: #f8f9fa;
    padding: 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
    border: 1px solid #e8e8ed;
  }

  .related-service:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
  }

  .related-service h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    color: #1d3557;
  }

  .related-service p {
    margin: 0;
    font-size: 0.875rem;
    color: #666;
  }

  .faq-list {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .faq-item {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid #e8e8ed;
  }

  .faq-item h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: #1d3557;
  }

  .faq-item p {
    margin: 0;
    font-size: 0.9375rem;
  }

  @media (max-width: 768px) {
    .process-step {
      grid-template-columns: 1fr;
    }

    .step-number {
      width: 40px;
      height: 40px;
      font-size: 1rem;
    }
  }
</style>
