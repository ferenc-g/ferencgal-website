    color: #666;
  }

  .faq-list {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .faq-item {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid #e8e8ed;
  }

  .faq-item h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: #1d3557;
  }

  .faq-item p {
    margin: 0;
    font-size: 0.9375rem;
  }
</style>