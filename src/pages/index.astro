---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch current (non-archived) blog posts at build time
const posts = await getCollection('blog');
const recentPosts = posts
    .filter(post => !post.data.archived)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 4);

const title = "Ferenc Gál | AI-Native Marketing Leadership in Healthtech";
const description = "Ferenc Gál is Global Marketing Lead at Lanas Healthcare Technology. He writes about healthtech marketing, AI in marketing, and marketing leadership.";
const keywords = "healthtech marketing, healthcare technology marketing, AI in marketing, AI-native marketing, marketing leadership, Ferenc Gál, Ferenc Gal, Dublin, Ireland";
---

<BaseLayout title={title} description={description} keywords={keywords}>
    <Fragment slot="head">
        <!-- Structured Data for SEO and AI Engines -->
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Person",
            "name": "Ferenc Gál",
            "alternateName": "Ferenc Gal",
            "url": "https://ferencgal.com",
            "image": "https://ferencgal.com/fg-headshot.webp",
            "jobTitle": "Global Marketing Lead",
            "worksFor": {
                "@type": "Organization",
                "name": "Lanas Healthcare Technology"
            },
            "description": "Marketing leader in healthcare technology. Writes about healthtech marketing, AI in marketing, and marketing leadership.",
            "knowsAbout": [
                "Healthcare Technology Marketing",
                "AI in Marketing",
                "B2B Marketing Strategy",
                "Brand Strategy",
                "Demand Generation",
                "Marketing Leadership"
            ],
            "alumniOf": [
                { "@type": "EducationalOrganization", "name": "Budapest University of Technology" },
                { "@type": "EducationalOrganization", "name": "Marketing Week" }
            ],
            "memberOf": {
                "@type": "Organization",
                "name": "Future Work World",
                "url": "https://members.futurework.world/"
            },
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Dublin",
                "addressCountry": "Ireland"
            },
            "sameAs": ["https://www.linkedin.com/in/ferencg/"]
        })} />
    </Fragment>

    <header class="hero hero--compact">
        <div class="hero-content">
            <div class="hero-intro">
                <div class="hero-image hero-image--small">
                    <img src="/fg-headshot.webp" alt="Ferenc Gál, Global Marketing Lead at Lanas Healthcare Technology" width="280" height="280" loading="eager">
                </div>
                <div class="hero-intro-text">
                    <p class="hero-eyebrow">Ferenc Gál</p>
                    <p class="hero-affiliation-inline">Global Marketing Lead at Lanas Healthcare Technology</p>
                </div>
            </div>
            <h1 class="hero-title">AI-native marketing leadership in <em>healthcare technology.</em></h1>
            <p class="hero-subtitle">Notes from the front line of marketing's AI transformation.</p>
            <div class="hero-cta-row">
                <a href="/blog" class="btn btn-primary btn-lg">Read the Blog <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
                <a href="/contact" class="btn btn-secondary btn-lg">Invite Me to Speak</a>
            </div>
        </div>
    </header>

    <section class="value-props">
        <div class="container">
            <div class="value-props-header reveal">
                <p class="value-props-bracket">[ On this site ]</p>
                <div class="value-props-title-row">
                    <svg class="value-props-arrow value-props-arrow--left" width="48" height="32" viewBox="0 0 48 32" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round"><path d="M4 16c12-8 24-8 40 4"/><path d="M38 14l6 6-8 2"/></svg>
                    <h2>3 Themes I <em>Write About</em></h2>
                    <svg class="value-props-arrow value-props-arrow--right" width="48" height="32" viewBox="0 0 48 32" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round"><path d="M44 16c-12-8-24-8-40 4"/><path d="M10 14l-6 6 8 2"/></svg>
                </div>
            </div>
            <div class="value-props-grid">
                <div class="value-prop-card reveal reveal-delay-1">
                    <div class="value-prop-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                    </div>
                    <h4>Healthtech Marketing</h4>
                    <p>Marketing healthcare technology means earning the trust of clinicians, executives, and regulators at the same time. I write about what works when the buyer is a hospital and the stakes are patient care.</p>
                </div>
                <div class="value-prop-card reveal reveal-delay-2">
                    <div class="value-prop-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5"><path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    </div>
                    <h4>AI in Marketing</h4>
                    <p>I build AI into the day-to-day work of marketing teams and share what actually holds up in practice: the workflows, the tooling, and the judgement calls automation cannot make.</p>
                </div>
                <div class="value-prop-card reveal reveal-delay-3">
                    <div class="value-prop-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    </div>
                    <h4>Marketing Leadership</h4>
                    <p>Lessons from leading multi-market B2B programmes: building teams, proving ROI to the board, and turning marketing into a growth engine rather than a cost centre.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="about" class="about">
        <div class="container">
            <div class="about-content reveal">
                <p class="section-eyebrow">About Me</p>
                <h2>From multi-market campaigns to healthtech leadership.</h2>
                <p>I am a marketing leader with more than a decade of experience building and executing multi-market B2B and B2C programmes across Europe, APAC, and the Americas.</p>
                <p>Today I lead global marketing at Lanas Healthcare Technology. I am based in Dublin, Ireland, and I use this site to share what I learn about healthtech marketing, AI in marketing, and leading modern marketing teams. The views here are my own.</p>
                <p><a href="/about">More about me and my career &rarr;</a></p>
            </div>
        </div>
    </section>

    <section id="speaking" class="speaking">
        <div class="container">
            <div class="reveal">
                <p class="section-eyebrow">Speaking &amp; Media</p>
                <h2>Contributing to the marketing conversation.</h2>
                <p class="section-intro">I am available for speaking engagements, panel discussions, and podcast conversations on healthtech marketing, AI in marketing, and marketing leadership.</p>
            </div>

            <div class="speaking-grid speaking-grid--three">
                <div class="speaking-card">
                    <div class="speaking-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                        </svg>
                    </div>
                    <h4>Keynote Speaking</h4>
                    <p>Engaging presentations on healthtech marketing, the impact of AI on how marketing teams work, and building modern B2B marketing functions.</p>
                </div>

                <div class="speaking-card">
                    <div class="speaking-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                        </svg>
                    </div>
                    <h4>Panel Discussions</h4>
                    <p>Contributing perspectives on marketing leadership, healthcare technology, and the changing shape of B2B marketing at industry events and conferences.</p>
                </div>

                <div class="speaking-card">
                    <div class="speaking-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                        </svg>
                    </div>
                    <h4>Podcasts &amp; Media</h4>
                    <p>Guest conversations on marketing, AI, and healthcare technology, sharing practical experience rather than theory.</p>
                </div>
            </div>

            <div class="speaking-cta">
                <p>Interested in having me speak at your event or join your podcast?</p>
                <a href="/contact" class="btn btn-primary">Get in Touch</a>
            </div>
        </div>
    </section>

    <section id="blog" class="blog">
        <div class="container">
            <div class="reveal">
                <p class="section-eyebrow">Writing</p>
                <h2>Thoughts on marketing, AI, and healthcare technology.</h2>
                <p class="section-intro"><a href="/blog">Browse all articles &rarr;</a></p>
            </div>

            <div class="blog-grid blog-grid-two">
                {recentPosts.map(post => (
                    <article class="blog-card">
                        <div class="blog-card-content">
                            <span class="blog-category">{post.data.category}</span>
                            <h3>{post.data.title}</h3>
                            <p>{post.data.description}</p>
                            <a href={`/blog/${post.slug}`} class="blog-link">Read the full article &rarr;</a>
                        </div>
                    </article>
                ))}
                <article class="blog-card">
                    <div class="blog-card-content">
                        <span class="blog-category">Podcast</span>
                        <h3>The Future of Work Podcast</h3>
                        <p>Explore the trends, technologies, and strategies shaping the future of work. Produced by Cpl's Future of Work Institute, this podcast features conversations with industry leaders on talent, culture, and workplace transformation.</p>
                        <a href="https://www.buzzsprout.com/1192058/episodes" target="_blank" rel="noopener" class="blog-link">Listen to episodes &rarr;</a>
                    </div>
                </article>
                <article class="blog-card">
                    <div class="blog-card-content">
                        <span class="blog-category">Community</span>
                        <h3>Future Work World</h3>
                        <p>I am a founding member of Future Work World, an exclusive network for senior leaders exploring the future of work. The community hosts regular events and discussions on talent strategy, workplace innovation, and leadership in a changing world.</p>
                        <a href="https://members.futurework.world/" target="_blank" rel="noopener" class="blog-link">Join the community &rarr;</a>
                    </div>
                </article>
            </div>

            <div class="blog-connect">
                <h3>Stay Connected</h3>
                <p>Follow me on LinkedIn for regular insights on healthtech marketing, AI in marketing, and marketing leadership.</p>
                <a href="https://www.linkedin.com/in/ferencg/" target="_blank" rel="noopener" class="linkedin-link linkedin-link-large">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                    Connect on LinkedIn
                </a>
            </div>
        </div>
    </section>

    <section id="contact" class="contact-cta-section">
        <div class="container">
            <div class="contact-cta-content reveal">
                <p class="section-eyebrow">Get in Touch</p>
                <h2>Let's talk marketing.</h2>
                <p>Whether you want me to speak at your event, join a podcast, or simply compare notes on healthtech marketing and AI, I would love to hear from you.</p>
                <div class="contact-cta-buttons">
                    <a href="/contact" class="btn btn-primary">Send a Message</a>
                    <a href="https://www.linkedin.com/in/ferencg/" target="_blank" rel="noopener" class="btn btn-secondary btn-icon">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                        </svg>
                        Connect on LinkedIn
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* Centered single-column hero (no split stat column) */
    .hero-content .hero-intro {
        justify-content: center;
    }

    .hero-content .hero-subtitle {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-content .hero-cta-row {
        justify-content: center;
    }

    /* Three speaking cards instead of four */
    @media (min-width: 769px) {
        .speaking-grid--three {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .about-content {
        max-width: 720px;
        margin: 0 auto;
        text-align: center;
    }

    .about-content .section-eyebrow {
        justify-content: center;
    }
</style>
