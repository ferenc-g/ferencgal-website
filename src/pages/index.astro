---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch blog posts at build time
const posts = await getCollection('blog');
const recentPosts = posts.sort((a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 4);

const title = "Ferenc Gal | Recruitment Marketing & Employer Branding";
const description = "Recruitment marketing and employer branding consultant in Dublin. Helping organisations become talent destinations.";
const keywords = "recruitment marketing, employer branding, employer brand, EVP, employer value proposition, talent attraction, recruitment marketing consultant, employer branding consultant, Dublin, Ireland, recruitment marketing audit, talent acquisition, candidate experience, employer brand strategy";
---

<BaseLayout title={title} description={description} keywords={keywords}>
    <Fragment slot="head">
        <!-- Structured Data for SEO and AI Engines -->
        <script type="application/ld+json" set:html={JSON.stringify({
