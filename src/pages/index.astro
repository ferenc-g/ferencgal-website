---
import BaseLayout from '../layouts/BaseLayout.astro';

// MAINTENANCE MODE HOMEPAGE
// The full homepage lives in git history (commit 82e5d31, src/pages/index.astro).
// Restore it and delete this version when the redesign ships.

const title = "Ferenc Gál | New Site Coming Soon";
const description = "ferencgal.com is being redesigned. New writing on healthtech marketing, AI in marketing, and marketing leadership is coming soon.";
---

<BaseLayout title={title} description={description}>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Person",
            "name": "Ferenc Gál",
            "alternateName": "Ferenc Gal",
            "url": "https://ferencgal.com",
            "image": "https://ferencgal.com/fg-headshot.webp",
            "jobTitle": "Global Marketing Lead",
            "worksFor": {
                "@type": "Organization",
                "name": "Lanas Healthcare Technology"
            },
            "description": "Marketing leader in healthcare technology. Writes about healthtech marketing, AI in marketing, and marketing leadership.",
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Dublin",
                "addressCountry": "Ireland"
            },
            "sameAs": ["https://www.linkedin.com/in/ferencg/"]
        })} />
    </Fragment>

    <section class="maintenance-page">
        <div class="maintenance-content">
            <img src="/fg-headshot.webp" alt="Ferenc Gál" width="96" height="96" loading="eager">
            <p class="maintenance-eyebrow">Ferenc Gál</p>
            <h1>A new site is <em>on the way.</em></h1>
            <p class="maintenance-desc">I'm redesigning ferencgal.com around healthtech marketing, AI in marketing, and marketing leadership. Check back soon.</p>
            <div class="maintenance-actions">
                <a href="https://www.linkedin.com/in/ferencg/" target="_blank" rel="noopener" class="btn btn-primary">Find Me on LinkedIn</a>
                <a href="/blog" class="btn btn-secondary">Read My Articles</a>
            </div>
        </div>
    </section>
</BaseLayout>

<style is:global>
    /* Maintenance mode: hide the site chrome on the homepage only */
    body:has(.maintenance-page) .nav,
    body:has(.maintenance-page) .footer,
    body:has(.maintenance-page) .maintenance-banner {
        display: none;
    }
</style>

<style>
    .maintenance-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--spacing-xl);
        background-color: var(--color-gray-50);
        text-align: center;
    }

    .maintenance-content {
        max-width: 480px;
    }

    .maintenance-content img {
        width: 96px;
        height: 96px;
        border-radius: var(--radius-full);
        object-fit: cover;
        border: 3px solid var(--color-white);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
        margin-bottom: var(--spacing-lg);
    }

    .maintenance-eyebrow {
        font-size: var(--font-size-xs);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--color-accent);
        margin-bottom: var(--spacing-sm);
    }

    .maintenance-page h1 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(2rem, 5vw, 2.75rem);
        line-height: 1.15;
        color: var(--color-primary-dark);
        margin-bottom: var(--spacing-md);
    }

    .maintenance-page h1 em {
        color: var(--color-accent);
        font-style: normal;
    }

    .maintenance-desc {
        color: var(--color-gray-500);
        line-height: 1.7;
        margin-bottom: var(--spacing-xl);
    }

    .maintenance-actions {
        display: flex;
        gap: var(--spacing-md);
        justify-content: center;
        flex-wrap: wrap;
    }
</style>
