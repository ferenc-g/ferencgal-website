---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Contact Ferenc Gal | Recruitment Marketing Consultant";
const description = "Get in touch to discuss your recruitment marketing and employer branding needs. Based in Dublin, serving organisations across Ireland and Europe.";
const keywords = "contact, recruitment marketing consultant, employer branding consultant, Dublin, Ireland";
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <div class="contact-page">
    <header class="contact-hero">
      <div class="container">
        <h1>Get in Touch</h1>
        <p>Let's discuss how I can help your organisation attract and retain the right talent.</p>
      </div>
    </header>

    <section class="contact-content">
      <div class="container">
        <div class="contact-grid">
          <div class="contact-info">
            <h2>Let's Start a Conversation</h2>
            <p>Whether you need a recruitment marketing audit, want to develop your employer brand, or are looking for ongoing strategic support, I'd be happy to discuss how I can help.</p>

            <div class="info-item">
              <h3>Location</h3>
              <p>Dublin, Ireland<br>Serving organisations across Ireland and Europe</p>
            </div>

            <div class="info-item">
              <h3>Services Delivered Through</h3>
              <p>All engagements are delivered through <a href="https://www.cpl.com/ie/for-clients/cpl-services/future-of-work-institute" target="_blank" rel="noopener">Cpl's Future of Work Institute</a>.</p>
            </div>

            <div class="info-item">
              <h3>Connect</h3>
              <p>
                <a href="https://www.linkedin.com/in/ferencg/" target="_blank" rel="noopener" class="linkedin-link">
                  <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  Connect on LinkedIn
                </a>
              </p>
            </div>

            <div class="response-note">
              <p><strong>Typical response time:</strong> Within 24-48 hours on business days.</p>
            </div>
          </div>

          <div class="contact-form-wrapper">
            <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
              <input type="hidden" name="access_key" value="4899b658-a4a2-4c76-91f2-46406119a68b">
              <input type="hidden" name="subject" value="New contact from ferencgal.com">
              <input type="hidden" name="from_name" value="Ferenc Gal Website">
              <input type="hidden" name="redirect" value="https://ferencgal.com/contact?success=true">
              <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

              <div class="form-group">
                <label for="name">Name <span class="required">*</span></label>
                <input type="text" id="name" name="name" required>
              </div>

              <div class="form-group">
                <label for="email">Email <span class="required">*</span></label>
                <input type="email" id="email" name="email" required>
              </div>

              <div class="form-group">
                <label for="company">Company</label>
                <input type="text" id="company" name="company">
              </div>

              <div class="form-group">
                <label for="service">Service Interest</label>
                <select id="service" name="service">
                  <option value="">Select a service...</option>
                  <option value="Recruitment Marketing Audit">Recruitment Marketing Audit</option>
                  <option value="EVP Development">EVP Development</option>
                  <option value="Outsourced Recruitment Marketing">Outsourced Recruitment Marketing</option>
                  <option value="Employer Brand Assessment">Employer Brand Assessment</option>
                  <option value="Employer Brand Activation">Employer Brand Activation</option>
                  <option value="Speaking/Workshop">Speaking or Workshop</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div class="form-group">
                <label for="message">How can I help? <span class="required">*</span></label>
                <textarea id="message" name="message" rows="5" required placeholder="Tell me about your recruitment marketing or employer branding challenges..."></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-full">Send Message</button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding-top: 80px;
  }

  .contact-hero {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: white;
    padding: 4rem 0;
    text-align: center;
  }

  .contact-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1rem;
    color: white;
  }

  .contact-hero p {
    font-size: 1.125rem;
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto;
    color: white;
  }

  .contact-content {
    padding: 4rem 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-info h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .contact-info > p {
    color: #555;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .info-item {
    margin-bottom: 1.5rem;
  }

  .info-item h3 {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #888;
    margin-bottom: 0.5rem;
  }

  .info-item p {
    color: #333;
    line-height: 1.6;
  }

  .info-item a {
    color: #1a1a2e;
    text-decoration: none;
  }

  .info-item a:hover {
    text-decoration: underline;
  }

  .linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #0077b5 !important;
  }

  .response-note {
    margin-top: 2rem;
    padding: 1rem;
    background: #f8f9fa;
    border-radius: 8px;
  }

  .response-note p {
    margin: 0;
    font-size: 0.875rem;
    color: #666;
  }

  .contact-form-wrapper {
    background: #f8f9fa;
    padding: 2rem;
    border-radius: 12px;
  }

  .contact-form {
    display: grid;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 500;
    font-size: 0.9375rem;
    color: #333;
  }

  .required {
    color: #e53e3e;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #64ffda;
    box-shadow: 0 0 0 3px rgba(100, 255, 218, 0.1);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .btn-full {
    width: 100%;
    padding: 1rem;
    font-size: 1rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .contact-form-wrapper {
      order: -1;
    }
  }
</style>
