---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Contact Ferenc Gál | Speaking, Podcasts & Media";
const description = "Get in touch with Ferenc Gál for speaking engagements, podcast appearances, media enquiries, or a conversation about healthtech marketing and AI.";
const keywords = "contact, Ferenc Gál, speaking, podcast, healthtech marketing, AI in marketing, Dublin, Ireland";
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <div class="contact-page">
    <header class="contact-hero">
      <div class="container">
        <div class="contact-hero-content">
          <div class="contact-hero-left">
            <p class="contact-eyebrow">Get in Touch</p>
            <h1>Let's talk <em>marketing.</em></h1>
            <p class="contact-hero-desc">Speaking invitations, podcast and media enquiries, or a conversation about healthtech marketing and AI: I'd love to hear from you.</p>
          </div>
          <div class="contact-hero-right">
            <div class="contact-proof-item">
              <span class="contact-proof-number">24-48h</span>
              <span class="contact-proof-label">Typical response time</span>
            </div>
            <div class="contact-proof-item">
              <span class="contact-proof-number">Dublin</span>
              <span class="contact-proof-label">Based in Ireland</span>
            </div>
            <div class="contact-proof-item">
              <span class="contact-proof-number">Global</span>
              <span class="contact-proof-label">Speaking &amp; media</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <section class="contact-content">
      <div class="container">
        <div class="contact-grid">
          <div class="contact-form-wrapper">
            <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
              <input type="hidden" name="access_key" value="4899b658-a4a2-4c76-91f2-46406119a68b">
              <input type="hidden" name="subject" value="New contact from ferencgal.com">
              <input type="hidden" name="from_name" value="Ferenc Gál Website">
              <input type="hidden" name="redirect" value="https://ferencgal.com/contact-success">
              <input type="checkbox" name="botcheck" class="hidden" style="display: none;" aria-hidden="true">

              <div class="form-group">
                <label for="name">Name <span class="required">*</span></label>
                <input type="text" id="name" name="name" required>
              </div>

              <div class="form-group">
                <label for="email">Email <span class="required">*</span></label>
                <input type="email" id="email" name="email" required>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="company">Company</label>
                  <input type="text" id="company" name="company">
                </div>

                <div class="form-group">
                  <label for="service">Topic</label>
                  <select id="service" name="service">
                    <option value="">Select a topic...</option>
                    <option value="Speaking Engagement">Speaking Engagement</option>
                    <option value="Podcast or Media">Podcast or Media</option>
                    <option value="Healthtech Marketing">Healthtech Marketing</option>
                    <option value="AI in Marketing">AI in Marketing</option>
                    <option value="Other">Other</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="message">What's on your mind? <span class="required">*</span></label>
                <textarea id="message" name="message" rows="5" required placeholder="Tell me about your event, podcast, or the marketing topic you'd like to discuss..."></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-full">Send Message</button>
            </form>
          </div>

          <div class="contact-info">
            <div class="info-card">
              <h3>Current Role</h3>
              <p>I lead global marketing at Lanas Healthcare Technology. This site reflects my personal views, and I do not offer consulting or agency services.</p>
            </div>

            <div class="info-card">
              <h3>Location</h3>
              <p>Dublin, Ireland<br>Happy to speak and collaborate internationally</p>
            </div>

            <div class="info-card">
              <h3>Connect</h3>
              <p>
                <a href="https://www.linkedin.com/in/ferencg/" target="_blank" rel="noopener" class="linkedin-link">
                  <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  Connect on LinkedIn
                </a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding-top: var(--nav-height);
  }

  .contact-hero {
    position: relative;
    background-color: var(--color-gray-50);
    padding: var(--spacing-2xl) 0;
    overflow: hidden;
  }

  .contact-hero-content {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--spacing-3xl);
    align-items: center;
  }

  .contact-eyebrow {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: var(--spacing-md);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .contact-eyebrow::before {
    content: '';
    width: 24px;
    height: 1px;
    background-color: var(--color-accent);
  }

  .contact-hero h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    margin-bottom: var(--spacing-md);
    color: var(--color-primary-dark);
  }

  .contact-hero h1 em {
    color: var(--color-accent);
    font-style: normal;
  }

  .contact-hero-desc {
    font-size: var(--font-size-base);
    color: var(--color-gray-500);
    line-height: 1.7;
  }

  .contact-hero-right {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }

  .contact-proof-item {
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg) var(--spacing-xl);
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .contact-proof-number {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    color: var(--color-primary-dark);
    font-weight: 400;
    white-space: nowrap;
  }

  .contact-proof-label {
    font-size: var(--font-size-xs);
    color: var(--color-gray-400);
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-content {
    padding: var(--spacing-2xl) 0 var(--spacing-3xl);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--spacing-2xl);
    align-items: start;
  }

  .contact-form-wrapper {
    background: var(--color-white);
    padding: var(--spacing-xl);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-gray-200);
  }

  .contact-form {
    display: grid;
    gap: var(--spacing-lg);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .form-group label {
    font-weight: 500;
    font-size: var(--font-size-sm);
    color: var(--color-gray-600);
    letter-spacing: 0.02em;
  }

  .required {
    color: #dc3545;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-gray-300);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-base);
    font-family: var(--font-body);
    background-color: var(--color-white);
    color: var(--color-gray-900);
    transition: var(--transition-base);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(42, 157, 143, 0.1);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .btn-full {
    width: 100%;
    padding: 0.875rem;
    font-size: var(--font-size-base);
    margin-top: var(--spacing-xs);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .info-card {
    background-color: var(--color-gray-50);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg) var(--spacing-xl);
  }

  .info-card h3 {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gray-400);
    margin-bottom: var(--spacing-xs);
  }

  .info-card p {
    color: var(--color-gray-600);
    line-height: 1.6;
    margin: 0;
  }

  .info-card a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 1px;
    transition: var(--transition-fast);
  }

  .info-card a:hover {
    color: var(--color-accent-dark);
  }

  .linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #0A66C2 !important;
    font-weight: 500;
    border-bottom: none !important;
  }

  .linkedin-link:hover {
    color: #004182 !important;
  }

  @media (max-width: 1024px) {
    .contact-hero-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }

    .contact-hero-right {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }

    .contact-hero-right {
      grid-template-columns: 1fr;
    }

    .contact-hero-content {
      text-align: center;
    }

    .contact-eyebrow {
      justify-content: center;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
