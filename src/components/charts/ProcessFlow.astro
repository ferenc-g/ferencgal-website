---
interface Step {
  number: number;
  label: string;
  description?: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<div class="process-flow">
  {steps.map((step, index) => (
    <div class="process-step" data-last={index === steps.length - 1 ? "true" : undefined}>
      <div class="process-number">{step.number}</div>
      <div class="process-label">{step.label}</div>
      {step.description && <div class="process-description">{step.description}</div>}
    </div>
  ))}
</div>

<style>
  .process-flow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    justify-content: center;
  }

  .process-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
    min-width: 140px;
    max-width: 200px;
    position: relative;
  }

  .process-step:not([data-last])::after {
    content: '';
    position: absolute;
    top: 20px;
    right: -15px;
    width: 20px;
    height: 2px;
    background-color: var(--color-accent);
  }

  .process-number {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary);
    color: var(--color-white);
    font-size: var(--font-size-lg);
    font-weight: 700;
    border-radius: var(--radius-full);
    margin-bottom: var(--spacing-sm);
  }

  .process-label {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-xs);
  }

  .process-description {
    font-size: var(--font-size-xs);
    color: var(--color-gray-500);
  }

  @media (max-width: 768px) {
    .process-step:not([data-last])::after {
      display: none;
    }

    .process-flow {
      flex-direction: column;
      align-items: center;
    }

    .process-step {
      max-width: 100%;
    }
  }
</style>
