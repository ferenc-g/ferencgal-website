---
interface ComparisonItem {
  label: string;
  before: string | number;
  after: string | number;
}

interface Props {
  items: ComparisonItem[];
  beforeLabel?: string;
  afterLabel?: string;
}

const {
  items,
  beforeLabel = 'Before',
  afterLabel = 'After'
} = Astro.props;
---

<div class="comparison-chart">
  <div class="comparison-header">
    <span class="comparison-header-label">{beforeLabel}</span>
    <span class="comparison-header-label">{afterLabel}</span>
  </div>
  {items.map((item) => (
    <div class="comparison-row">
      <div class="comparison-before">
        <span class="comparison-value">{item.before}</span>
      </div>
      <div class="comparison-label">{item.label}</div>
      <div class="comparison-after">
        <span class="comparison-value">{item.after}</span>
      </div>
    </div>
  ))}
</div>

<style>
  .comparison-chart {
    width: 100%;
  }

  .comparison-header {
    display: flex;
    justify-content: space-between;
    padding: 0 var(--spacing-md);
    margin-bottom: var(--spacing-sm);
  }

  .comparison-header-label {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-gray-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .comparison-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--spacing-md);
    align-items: center;
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .comparison-row:last-child {
    border-bottom: none;
  }

  .comparison-before {
    text-align: left;
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-gray-100);
    border-radius: var(--radius-sm);
  }

  .comparison-after {
    text-align: right;
    padding: var(--spacing-sm) var(--spacing-md);
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
    border-radius: var(--radius-sm);
  }

  .comparison-after .comparison-value {
    color: var(--color-white);
  }

  .comparison-label {
    font-size: var(--font-size-sm);
    color: var(--color-gray-600);
    text-align: center;
    padding: 0 var(--spacing-sm);
  }

  .comparison-value {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-gray-900);
  }

  @media (max-width: 768px) {
    .comparison-row {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-sm);
    }

    .comparison-label {
      grid-column: 1 / -1;
      order: -1;
      text-align: left;
      padding: 0;
      margin-bottom: var(--spacing-xs);
    }

    .comparison-before,
    .comparison-after {
      text-align: center;
    }
  }
</style>
